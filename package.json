{
  "name": "zenthcloud",
  "version": "1.0.0",
  "description": "An open-source, sovereign and ethical cloud platform built for transparency, control, and modular infrastructure.",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps",
    "tools",
    "tests",
    "messages",
    "server/prisma",
    "package",
    "package/cli"
  ],
  "scripts": {
    "dev": "concurrently \"pnpm --filter apps dev\" \"pnpm --filter server dev\"",
    "dev:frontend": "pnpm --filter apps dev",
    "dev:backend": "pnpm --filter server dev",
    "dev:cli": "pnpm --filter cli dev",
    "build": "pnpm -r build",
    "build:frontend": "pnpm --filter apps build",
    "build:backend": "pnpm --filter server build",
    "build:cli": "pnpm --filter cli build",
    "start": "concurrently \"pnpm --filter apps start\" \"pnpm --filter server start\"",
    "lint": "pnpm -r lint",
    "lint:fix": "pnpm -r lint:fix",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "clean": "pnpm -r clean && rm -rf node_modules",
    "reset": "pnpm clean && pnpm install",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "db:seed": "prisma db seed",
    "cli": "pnpm --filter cli cli",
    "docker:build": "docker build -t aether-mailer .",
    "docker:run": "docker-compose up -d",
    "docker:stop": "docker-compose down",
    "prepare": "husky install",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm build && changeset publish",
    "build:workspace": "tsc -b tsconfig.build.json",
    "build:all": "tsc -b",
    "clean:build": "pnpm -r exec rm -rf dist && rm -rf packages/*/dist",
    "install:all": "pnpm install && pnpm -r install",
    "update:all": "pnpm update && pnpm -r update",
    "clean:deps": "pnpm -r exec rm -rf node_modules && rm -rf node_modules pnpm-lock.yaml"
  },
  "devDependencies": {
    "@changesets/cli": "^2.30.0",
    "@prisma/client": "7.9.1",
    "@types/node": "^25.5.0",
    "concurrently": "^9.2.1",
    "eslint": "^10",
    "husky": "^9.0.11",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.1",
    "prisma": "7.9.1",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  },
  "packageManager": "pnpm@8.15.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/skygenesisenterprise/zenthcloud.git"
  },
  "keywords": [
    "news",
    "website",
    "react",
    "nextjs",
    "prisma",
    "typescript"
  ],
  "author": {
    "name": "ZenthCloud Enterprise",
    "email": "developer@zenthcloud.com",
    "url": "https://zenthcloud.com"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/skygenesisenterprise/zenthcloud/issues"
  },
  "homepage": "https://github.com/skygenesisenterprise/zenthcloud#readme",
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix --quiet",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@capacitor/core": "^8.2.0",
    "@fontsource-variable/mona-sans": "^5.2.8",
    "@loglayer/transport-pino": "^3.0.2",
    "@prisma/client": "^7.9.1",
    "@radix-ui/react-slot": "^1.2.4",
    "@vercel/analytics": "^2.0.1",
    "class-variance-authority": "^0.7.1",
    "dotenv": "^17.4.0",
    "framer-motion": "^13.1.1",
    "loglayer": "^9.1.0",
    "next": "^16.2.2",
    "next-intl": "^4.8.3",
    "pino": "^10.3.1",
    "stylelint": "^17.6.0",
    "updates": "^17.13.5"
  }
}
